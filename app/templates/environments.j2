{% extends "base.j2" %}

{% block content %}
<h2>Environments</h2>

<h3>Liste</h3>
<form method="get" action="/call/environments/list">
    <button type="submit">GET /environments</button>
</form>

<h3>Créer</h3>
<form method="post" action="/call/environments/create">
    <input name="name" placeholder="Nom"><br>
    <select name="type">
        <option>development</option>
        <option>staging</option>
        <option>production</option>
    </select><br>
    <input name="url" placeholder="URL"><br>
    <button type="submit">POST /environments</button>
</form>

{% if response %}
<h3>Réponse API</h3>
<pre>{{ response | tojson(indent=2) }}</pre>
{% endif %}
{% endblock %}
